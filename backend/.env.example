# ── Core ────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/naati?schema=public"
PORT=4000
APP_ENV=development
SITE_URL=http://localhost:4000
API_PUBLIC_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# ── Auth ────────────────────────────────────────────────────────────
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m

# ── Payments ────────────────────────────────────────────────────────
# Currency used for every course checkout (ISO-4217).
PAYMENT_CURRENCY=AUD

# Stripe — powers both the hosted "Stripe" method and the card form.
# Leave blank to run checkout in sandbox mode (settled from the status page).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Seconds of clock skew tolerated on webhook signatures.
STRIPE_WEBHOOK_TOLERANCE=300

# Forward raw card numbers to Stripe instead of requiring a Stripe.js token.
# Only turn this on if the account is PCI-DSS approved for raw PAN handling.
PAYMENTS_ALLOW_RAW_CARD=false

# Payoneer Checkout (Open Payment Platform).
# Sandbox: https://api.sandbox.oscato.com  ·  Live: https://api.oscato.com
PAYONEER_API_BASE=https://api.sandbox.oscato.com
PAYONEER_MERCHANT_CODE=
PAYONEER_API_KEY=
PAYONEER_DIVISION=
PAYONEER_COUNTRY=AU
# Shared secret used to sign notification callbacks (optional).
PAYONEER_NOTIFICATION_SECRET=

# ── Mail ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NAATI Excellence Academy <no-reply@naatiexcellence.com.au>"

# ── Google OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback
